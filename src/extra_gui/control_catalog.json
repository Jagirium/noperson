[{"id":"ProvidersPrioritySelection","scope":"settings","section":"General","label":"Providers Priority","level":1,"help":"Select the providers priority to be used with the system.","kind":{"type":"choice","options":["CUDA","TensorRT"],"default":"CUDA"}},{"id":"nThreadsSlider","scope":"settings","section":"General","label":"FFmpeg CPU Threads","level":1,"help":"Set the bounded FFmpeg decode and encode CPU thread budget. GPU inference remains one ordered worker without duplicating model sessions.","kind":{"type":"slider","min":1.0,"max":30.0,"default":2.0,"step":1.0}},{"id":"VideoPlaybackCustomFpsToggle","scope":"settings","section":"Video Settings","label":"Set Custom Video Playback FPS","level":1,"help":"Manually set the FPS to be used when playing the video","kind":{"type":"toggle","default":false}},{"id":"VideoPlaybackCustomFpsSlider","scope":"settings","section":"Video Settings","label":"Video Playback FPS","level":2,"help":"Set the maximum FPS of the video when playing","kind":{"type":"slider","min":1.0,"max":120.0,"default":60.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"VideoPlaybackCustomFpsToggle","value":true}],"hidden_modes":[]}},{"id":"AutoSwapToggle","scope":"settings","section":"Auto Swap","label":"Auto Swap","level":1,"help":"Automatically Swap all faces using selected Source Faces/Embeddings when loading an video/image file","kind":{"type":"toggle","default":false}},{"id":"DetectorModelSelection","scope":"settings","section":"Detectors","label":"Face Detect Model","level":1,"help":"Select the face detection model to use for detecting faces in the input image or video.","kind":{"type":"choice","options":["RetinaFace","Yolov8","SCRFD"],"default":"Yolov8"}},{"id":"DetectorScoreSlider","scope":"settings","section":"Detectors","label":"Detect Score","level":1,"help":"Set the confidence score threshold for face detection. Higher values ensure more confident detections but may miss some faces.","kind":{"type":"slider","min":1.0,"max":100.0,"default":50.0,"step":1.0}},{"id":"MaxFacesToDetectSlider","scope":"settings","section":"Detectors","label":"Max No of Faces to Detect","level":1,"help":"Set the maximum number of faces to detect in a frame","kind":{"type":"slider","min":1.0,"max":50.0,"default":20.0,"step":1.0}},{"id":"AutoRotationToggle","scope":"settings","section":"Detectors","label":"Auto Rotation","level":1,"help":"Automatically rotate the input to detect faces in various orientations.","kind":{"type":"toggle","default":false}},{"id":"ManualRotationEnableToggle","scope":"settings","section":"Detectors","label":"Manual Rotation","level":1,"help":"Rotate the face detector to better detect faces at different angles.","kind":{"type":"toggle","default":false}},{"id":"ManualRotationAngleSlider","scope":"settings","section":"Detectors","label":"Rotation Angle","level":2,"help":"Set this to the angle of the input face angle to help with laying down/upside down/etc. Angles are read clockwise.","kind":{"type":"slider","min":0.0,"max":270.0,"default":0.0,"step":90.0},"visibility":{"mode":"all","dependencies":[{"control":"ManualRotationEnableToggle","value":true}],"hidden_modes":[]}},{"id":"LandmarkDetectToggle","scope":"settings","section":"Detectors","label":"Enable Landmark Detection","level":1,"help":"Enable or disable facial landmark detection, which is used to refine face alignment.","kind":{"type":"toggle","default":false}},{"id":"LandmarkDetectModelSelection","scope":"settings","section":"Detectors","label":"Landmark Detect Model","level":2,"help":"Select the landmark detection model, where different models detect varying numbers of facial landmarks.","kind":{"type":"choice","options":["5","68","3d68","98","106","203","478"],"default":"203"},"visibility":{"mode":"all","dependencies":[{"control":"LandmarkDetectToggle","value":true}],"hidden_modes":[]}},{"id":"LandmarkDetectScoreSlider","scope":"settings","section":"Detectors","label":"Landmark Detect Score","level":2,"help":"Set the confidence score threshold for facial landmark detection.","kind":{"type":"slider","min":1.0,"max":100.0,"default":50.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"LandmarkDetectToggle","value":true}],"hidden_modes":[]}},{"id":"DetectFromPointsToggle","scope":"settings","section":"Detectors","label":"Detect From Points","level":2,"help":"Enable detection of faces from specified landmark points.","kind":{"type":"toggle","default":false},"visibility":{"mode":"all","dependencies":[{"control":"LandmarkDetectToggle","value":true}],"hidden_modes":[]}},{"id":"ShowLandmarksEnableToggle","scope":"settings","section":"Detectors","label":"Show Landmarks","level":1,"help":"Show Landmarks in realtime.","kind":{"type":"toggle","default":false}},{"id":"ShowAllDetectedFacesBBoxToggle","scope":"settings","section":"Detectors","label":"Show Bounding Boxes","level":1,"help":"Draw bounding boxes to all detected faces in the frame","kind":{"type":"toggle","default":false}},{"id":"MaxDFMModelsSlider","scope":"settings","section":"DFM Settings","label":"Maximum DFM Models to use","level":1,"help":"Set the maximum number of DFM Models to keep in memory at a time. Set this based on your GPU's VRAM","kind":{"type":"slider","min":1.0,"max":5.0,"default":1.0,"step":1.0}},{"id":"FrameEnhancerEnableToggle","scope":"settings","section":"Frame Enhancer","label":"Enable Frame Enhancer","level":1,"help":"Enable frame enhancement for video inputs to improve visual quality.","kind":{"type":"toggle","default":false},"visibility":{"mode":"all","dependencies":[],"hidden_modes":["realtime"]}},{"id":"FrameEnhancerTypeSelection","scope":"settings","section":"Frame Enhancer","label":"Frame Enhancer Type","level":2,"help":"Select the type of frame enhancement to apply, based on the content and resolution requirements.","kind":{"type":"choice","options":["RealEsrgan-x2-Plus","RealEsrgan-x4-Plus","RealEsr-General-x4v3","BSRGan-x2","BSRGan-x4","UltraSharp-x4","UltraMix-x4"],"default":"RealEsrgan-x2-Plus"},"visibility":{"mode":"all","dependencies":[{"control":"FrameEnhancerEnableToggle","value":true}],"hidden_modes":["realtime"]}},{"id":"FrameEnhancerBlendSlider","scope":"settings","section":"Frame Enhancer","label":"Blend","level":2,"help":"Blends the enhanced results back into the original frame.","kind":{"type":"slider","min":0.0,"max":100.0,"default":100.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"FrameEnhancerEnableToggle","value":true}],"hidden_modes":["realtime"]}},{"id":"WebcamCameraSelection","scope":"settings","section":"Webcam Settings","label":"Webcam Preset","level":2,"help":"Select the resolution and FPS preset for the active webcam. Choose a camera in the Media Panel first.","kind":{"type":"choice","options":["Choose camera"],"default":"Choose camera","source":"cameras"},"visibility":{"mode":"all","dependencies":[],"hidden_modes":["editor"]}},{"id":"SendVirtCamFramesEnableToggle","scope":"settings","section":"Virtual Camera","label":"Send Frames to Virtual Camera","level":1,"help":"Send the swapped video/webcam output to virtual camera for using in external applications","kind":{"type":"toggle","default":false},"visibility":{"mode":"all","dependencies":[],"hidden_modes":["editor"]}},{"id":"VirtCamBackendSelection","scope":"settings","section":"Virtual Camera","label":"Virtual Camera Backend","level":1,"help":"Choose the backend based on the Virtual Camera you have set up","kind":{"type":"choice","options":["obs","v4l2loopback","unitycapture"],"default":"obs"},"visibility":{"mode":"all","dependencies":[{"control":"SendVirtCamFramesEnableToggle","value":true}],"hidden_modes":["editor"]}},{"id":"SimilarityTypeSelection","scope":"settings","section":"Face Recognition","label":"Swapping Similarity Type","level":1,"help":"Choose the type of similarity calculation for face detection and matching during the face swapping process.","kind":{"type":"choice","options":["Opal","Pearl","Optimal"],"default":"Opal"}},{"id":"EmbMergeMethodSelection","scope":"settings","section":"Embedding Merge Method","label":"Embedding Merge Method","level":1,"help":"Select the method to merge facial embeddings. \"Mean\" averages the embeddings, while \"Median\" selects the middle value, providing more robustness to outliers.","kind":{"type":"choice","options":["Mean","Median"],"default":"Mean"}},{"id":"TargetMediaFolderRecursiveToggle","scope":"settings","section":"Media Selection","label":"Target Media Include Subfolders","level":1,"help":"Include all files from Subfolders when choosing Target Media Folder","kind":{"type":"toggle","default":false}},{"id":"InputFacesFolderRecursiveToggle","scope":"settings","section":"Media Selection","label":"Input Faces Include Subfolders","level":1,"help":"Include all files from Subfolders when choosing Input Faces Folder","kind":{"type":"toggle","default":false}},{"id":"ScrollChangesValuesToggle","scope":"settings","section":"UI Behavior","label":"Scroll Changes Widget Values","level":1,"help":"Allow mouse scroll wheel to change values in dropdowns and sliders. When disabled, scrolling passes through to the scroll area.","kind":{"type":"toggle","default":false}},{"id":"FaceRestorerEnableToggle","scope":"common","section":"Face Restorer","label":"Enable Face Restorer","level":1,"help":"Enable the use of a face restoration model to improve the quality of the face after swapping.","kind":{"type":"toggle","default":false}},{"id":"FaceRestorerTypeSelection","scope":"common","section":"Face Restorer","label":"Restorer Type","level":2,"help":"Select the model type for face restoration.","kind":{"type":"choice","options":["GPEN-256","GPEN-512"],"default":"GPEN-256"},"visibility":{"mode":"all","dependencies":[{"control":"FaceRestorerEnableToggle","value":true}],"hidden_modes":[]}},{"id":"FaceRestorerDetTypeSelection","scope":"common","section":"Face Restorer","label":"Alignment","level":2,"help":"Select the alignment method for restoring the face to its original or blended position.","kind":{"type":"choice","options":["Original","Blend","Reference"],"default":"Original"},"visibility":{"mode":"all","dependencies":[{"control":"FaceRestorerEnableToggle","value":true}],"hidden_modes":[]}},{"id":"FaceFidelityWeightDecimalSlider","scope":"common","section":"Face Restorer","label":"Fidelity Weight","level":2,"help":"Adjust the fidelity weight to control how closely the restoration preserves the original face details.","kind":{"type":"slider","min":0.0,"max":1.0,"default":0.9,"step":0.1},"visibility":{"mode":"all","dependencies":[{"control":"FaceRestorerEnableToggle","value":true}],"hidden_modes":[]}},{"id":"FaceRestorerBlendSlider","scope":"common","section":"Face Restorer","label":"Blend","level":2,"help":"Control the blend ratio between the restored face and the swapped face.","kind":{"type":"slider","min":0.0,"max":100.0,"default":100.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"FaceRestorerEnableToggle","value":true}],"hidden_modes":[]}},{"id":"FaceRestorerEnable2Toggle","scope":"common","section":"Face Restorer","label":"Enable Face Restorer 2","level":1,"help":"Enable the use of a face restoration model to improve the quality of the face after swapping.","kind":{"type":"toggle","default":false}},{"id":"FaceRestorerType2Selection","scope":"common","section":"Face Restorer","label":"Restorer Type","level":2,"help":"Select the model type for face restoration.","kind":{"type":"choice","options":["GPEN-256","GPEN-512"],"default":"GPEN-256"},"visibility":{"mode":"all","dependencies":[{"control":"FaceRestorerEnable2Toggle","value":true}],"hidden_modes":[]}},{"id":"FaceRestorerDetType2Selection","scope":"common","section":"Face Restorer","label":"Alignment","level":2,"help":"Select the alignment method for restoring the face to its original or blended position.","kind":{"type":"choice","options":["Original","Blend","Reference"],"default":"Original"},"visibility":{"mode":"all","dependencies":[{"control":"FaceRestorerEnable2Toggle","value":true}],"hidden_modes":[]}},{"id":"FaceFidelityWeight2DecimalSlider","scope":"common","section":"Face Restorer","label":"Fidelity Weight","level":2,"help":"Adjust the fidelity weight to control how closely the restoration preserves the original face details.","kind":{"type":"slider","min":0.0,"max":1.0,"default":0.9,"step":0.1},"visibility":{"mode":"all","dependencies":[{"control":"FaceRestorerEnable2Toggle","value":true}],"hidden_modes":[]}},{"id":"FaceRestorerBlend2Slider","scope":"common","section":"Face Restorer","label":"Blend","level":2,"help":"Control the blend ratio between the restored face and the swapped face.","kind":{"type":"slider","min":0.0,"max":100.0,"default":100.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"FaceRestorerEnable2Toggle","value":true}],"hidden_modes":[]}},{"id":"SwapModelSelection","scope":"swapper","section":"Swapper","label":"Swapper Model","level":1,"help":"Choose which swapper model to use for face swapping.","kind":{"type":"choice","options":["Inswapper128","DeepFaceLive (DFM)"],"default":"Inswapper128"}},{"id":"SwapperResSelection","scope":"swapper","section":"Swapper","label":"Swapper Resolution","level":2,"help":"Select the resolution for the swapped face in pixels. Higher values offer better quality but are slower to process.","kind":{"type":"choice","options":["128","256","384","512"],"default":"128"},"visibility":{"mode":"all","dependencies":[{"control":"SwapModelSelection","value":"Inswapper128"}],"hidden_modes":[]}},{"id":"DFMModelSelection","scope":"swapper","section":"Swapper","label":"DFM Model","level":2,"help":"Select which pretrained DeepFaceLive (DFM) Model to use for swapping.","kind":{"type":"choice","options":[],"default":"","source":"dfm-models"},"visibility":{"mode":"all","dependencies":[{"control":"SwapModelSelection","value":"DeepFaceLive (DFM)"}],"hidden_modes":[]}},{"id":"DFMAmpMorphSlider","scope":"swapper","section":"Swapper","label":"AMP Morph Factor","level":2,"help":"AMP Morph Factor for DFM AMP Models","kind":{"type":"slider","min":1.0,"max":100.0,"default":50.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"SwapModelSelection","value":"DeepFaceLive (DFM)"}],"hidden_modes":[]}},{"id":"DFMRCTColorToggle","scope":"swapper","section":"Swapper","label":"RCT Color Transfer","level":2,"help":"RCT Color Transfer for DFM Models","kind":{"type":"toggle","default":false},"visibility":{"mode":"all","dependencies":[{"control":"SwapModelSelection","value":"DeepFaceLive (DFM)"}],"hidden_modes":[]}},{"id":"FaceAdjEnableToggle","scope":"swapper","section":"Face Landmarks Correction","label":"Face Adjustments","level":1,"help":"This is an experimental feature to perform direct adjustments to the face landmarks found by the detector. There is also an option to adjust the scale of the swapped face.","kind":{"type":"toggle","default":false}},{"id":"KpsXSlider","scope":"swapper","section":"Face Landmarks Correction","label":"Keypoints X-Axis","level":2,"help":"Shifts the detection points left and right.","kind":{"type":"slider","min":-100.0,"max":100.0,"default":0.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"FaceAdjEnableToggle","value":true}],"hidden_modes":[]}},{"id":"KpsYSlider","scope":"swapper","section":"Face Landmarks Correction","label":"Keypoints Y-Axis","level":2,"help":"Shifts the detection points up and down.","kind":{"type":"slider","min":-100.0,"max":100.0,"default":0.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"FaceAdjEnableToggle","value":true}],"hidden_modes":[]}},{"id":"KpsScaleSlider","scope":"swapper","section":"Face Landmarks Correction","label":"Keypoints Scale","level":2,"help":"Grows and shrinks the detection point distances.","kind":{"type":"slider","min":-100.0,"max":100.0,"default":0.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"FaceAdjEnableToggle","value":true}],"hidden_modes":[]}},{"id":"FaceScaleAmountSlider","scope":"swapper","sec