1.0},"visibility":{"mode":"all","dependencies":[{"control":"LandmarksPositionAdjEnableToggle","value":true}],"hidden_modes":[]}},{"id":"NoseXAmountSlider","scope":"swapper","section":"Face Landmarks Correction","label":"Nose:   X","level":2,"help":"Shifts the nose detection point left and right.","kind":{"type":"slider","min":-100.0,"max":100.0,"default":0.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"LandmarksPositionAdjEnableToggle","value":true}],"hidden_modes":[]}},{"id":"NoseYAmountSlider","scope":"swapper","section":"Face Landmarks Correction","label":"Nose:   Y","level":2,"help":"Shifts the nose detection point up and down.","kind":{"type":"slider","min":-100.0,"max":100.0,"default":0.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"LandmarksPositionAdjEnableToggle","value":true}],"hidden_modes":[]}},{"id":"MouthLeftXAmountSlider","scope":"swapper","section":"Face Landmarks Correction","label":"Left Mouth:   X","level":2,"help":"Shifts the mouth left detection point left and right.","kind":{"type":"slider","min":-100.0,"max":100.0,"default":0.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"LandmarksPositionAdjEnableToggle","value":true}],"hidden_modes":[]}},{"id":"MouthLeftYAmountSlider","scope":"swapper","section":"Face Landmarks Correction","label":"Left Mouth:   Y","level":2,"help":"Shifts the mouth left detection point up and down.","kind":{"type":"slider","min":-100.0,"max":100.0,"default":0.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"LandmarksPositionAdjEnableToggle","value":true}],"hidden_modes":[]}},{"id":"MouthRightXAmountSlider","scope":"swapper","section":"Face Landmarks Correction","label":"Right Mouth:   X","level":2,"help":"Shifts the mouth Right detection point left and right.","kind":{"type":"slider","min":-100.0,"max":100.0,"default":0.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"LandmarksPositionAdjEnableToggle","value":true}],"hidden_modes":[]}},{"id":"MouthRightYAmountSlider","scope":"swapper","section":"Face Landmarks Correction","label":"Right Mouth:   Y","level":2,"help":"Shifts the mouth Right detection point up and down.","kind":{"type":"slider","min":-100.0,"max":100.0,"default":0.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"LandmarksPositionAdjEnableToggle","value":true}],"hidden_modes":[]}},{"id":"SimilarityThresholdSlider","scope":"swapper","section":"Face Similarity","label":"Similarity Threshold","level":1,"help":"Set the similarity threshold to control how similar the detected face should be to the reference (target) face.","kind":{"type":"slider","min":1.0,"max":100.0,"default":60.0,"step":1.0}},{"id":"StrengthEnableToggle","scope":"swapper","section":"Face Similarity","label":"Strength","level":1,"help":"Apply additional swapping iterations to increase the strength of the result, which may increase likeness.","kind":{"type":"toggle","default":false}},{"id":"StrengthAmountSlider","scope":"swapper","section":"Face Similarity","label":"Amount","level":2,"help":"Increase up to 5x additional swaps (500%). 200% is generally a good result. Set to 0 to turn off swapping but allow the rest of the pipeline to apply to the original image.","kind":{"type":"slider","min":0.0,"max":500.0,"default":100.0,"step":25.0},"visibility":{"mode":"all","dependencies":[{"control":"StrengthEnableToggle","value":true}],"hidden_modes":[]}},{"id":"FaceLikenessEnableToggle","scope":"swapper","section":"Face Similarity","label":"Face Likeness","level":1,"help":"This is a feature to perform direct adjustments to likeness of faces.","kind":{"type":"toggle","default":false}},{"id":"FaceLikenessFactorDecimalSlider","scope":"swapper","section":"Face Similarity","label":"Amount","level":2,"help":"Determines the factor of likeness between the source and assigned faces.","kind":{"type":"slider","min":-1.0,"max":1.0,"default":0.0,"step":0.05},"visibility":{"mode":"all","dependencies":[{"control":"FaceLikenessEnableToggle","value":true}],"hidden_modes":[]}},{"id":"DifferencingEnableToggle","scope":"swapper","section":"Face Similarity","label":"Differencing","level":1,"help":"Allow some of the original face to show in the swapped result when the difference between the two images is small. Can help bring back some texture to the swapped face.","kind":{"type":"toggle","default":false}},{"id":"DifferencingAmountSlider","scope":"swapper","section":"Face Similarity","label":"Amount","level":2,"help":"Higher values relaxes the similarity constraint.","kind":{"type":"slider","min":0.0,"max":100.0,"default":4.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"DifferencingEnableToggle","value":true}],"hidden_modes":[]}},{"id":"DifferencingBlendAmountSlider","scope":"swapper","section":"Face Similarity","label":"Blend Amount","level":2,"help":"Blend differecing value.","kind":{"type":"slider","min":0.0,"max":100.0,"default":5.0,"step":1.0},"visibility":{"mode":"all","dependencies":[{"control":"DifferencingEnableToggle","value":true}],"hidden_modes":[]}},{"id":"BorderBottomSlider","scope":"swapper","section":"Face Mask","label":"Bottom Border","level":1,"help":"A rectangle with adjustable bottom, left, right, top, and sides that masks the swapped face result back into the original image.","kind":{"type":"slider","min":0.0,"max":100.0,"default":10.0,"step":1.0}},{"id":"BorderLeftSlider","scope":"swapper","section":"Face Mask","label":"Left Border","level":1,"help":"A rectangle with adjustable bottom, left, right, top, and sides that masks the swapped face result back into the original image.","kind":{"type":"slider","min":0.0,"max":100.0,"default":10.0,"step":1.0}},{"id":"BorderRightSlider","scope":"swapper","section":"Face Mask","label":"Right Border","level":1,"help":"A rectangle with adjustable bottom, left, right, top, and sides that masks the swapped face result back into the original image.","kind":{"type":"slider","min":0.0,"max":100.0,"defa